pipline{
    agent any

    enviroment{
        DOCKER_IMAGE = "abhilashgs14/abhilash"
    }

    stages{
        stage('Clone Repository') {
            steps{
                git 'https://github.com/vulcansmith-dev/https://github.com/vulcansmith-dev/Docker'
            }
        }

        stage('Build Docker Image'){
            steps{
                script{
                    docker.build("${DOCKER_IMAGE}:Devops")
                }
            }
        }
    }
}